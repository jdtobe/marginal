root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,css,yml,yaml,toml,json}]
indent_size = 2

# Fixtures test exact bytes; never let an editor normalize them.
[fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
